          }
        ]
      },
      "components": {
        "maxItems": 20,
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "textInput"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "placeholder": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "disabled": {
                      "type": "boolean"
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                },
                "besidePrevious": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "props"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "emailInput"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "placeholder": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "disabled": {
                      "type": "boolean"
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                },
                "besidePrevious": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "props"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "passwordInput"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "placeholder": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "disabled": {
                      "type": "boolean"
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                },
                "besidePrevious": {
                  "type": "boolean"
                }
              },
              "required": [
                "type",
                "props"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "checkbox"
                },
                "props": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "disabled": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                },
                "besidePrevious": {
                  "type": "boolean"
                }
              },
              "required": [
