API_HOST=127.0.0.1
API_PORT=3001
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_BODY_LIMIT_BYTES=8192
API_GENERATION_TIMEOUT_MS=5000
API_REQUEST_TIMEOUT_MS=15000

# Safe default: existing deterministic non-AI examples. Set ollama to opt in.
API_PROVIDER=mock
# With API_PROVIDER=ollama, choose draft, semantic-plan or flat-selection; restart after changing.
OLLAMA_WORKFLOW=draft
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_MS=60000
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_MAX_OUTPUT_TOKENS=2048
OLLAMA_RESPONSE_LIMIT_BYTES=65536

# Opt-in safe failure metadata only. Also requires NODE_ENV=development.
# Ignored in production, test, or when NODE_ENV is unset. No prompts/output values.
API_LOCAL_DIAGNOSTICS=false
